generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  PAYMENT_FAILED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]
  keys      IdempotencyKey[]
  @@map("customers")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  sku       String   @unique
  name      String
  price     Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  inventory Inventory?
  items     OrderItem[]
  @@map("products")
}

model Inventory {
  productId         String   @id @db.Uuid @map("product_id")
  availableQuantity Int      @default(0) @map("available_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at")
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservations      InventoryReservation[]
  @@map("inventory")
  @@index([availableQuantity])
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  customerId  String      @db.Uuid @map("customer_id")
  status      OrderStatus @default(PENDING_PAYMENT)
  totalAmount Decimal     @db.Decimal(12, 2) @map("total_amount")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  reservations InventoryReservation[]
  idempotencyKey IdempotencyKey?
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid @map("order_id")
  productId String  @db.Uuid @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) @map("unit_price")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([orderId, productId])
  @@map("order_items")
}

model InventoryReservation {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String            @db.Uuid @map("order_id")
  productId String            @db.Uuid @map("product_id")
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory Inventory         @relation(fields: [productId], references: [productId], onDelete: Restrict)
  @@unique([orderId, productId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid @map("customer_id")
  key          String
  requestHash  String   @map("request_hash")
  responseBody Json?    @map("response_body")
  orderId      String?  @unique @db.Uuid @map("order_id")
  createdAt    DateTime @default(now()) @map("created_at")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@unique([customerId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
